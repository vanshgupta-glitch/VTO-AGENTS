# Copy to `.secrets.env` (git-ignored) and fill with real values.
# NEVER commit. NEVER paste tokens into chat. Token set derived from the
# authoritative agents/*/agent.yaml + personas/*.yaml (10 bot tokens + 1 app token).

# ── Slack app-level token — ONLY on the listener app (admin), scope connections:write
SLACK_APP_TOKEN=xapp-...

# ── Agent bot tokens (6) — one Slack app each ────────────────────────
SLACK_BOT_ADMIN=xoxb-...      # listener + workspace admin (channels:manage, groups:write)
SLACK_BOT_CLAUDE=xoxb-...
SLACK_BOT_CRITIC=xoxb-...
SLACK_BOT_RESEARCH=xoxb-...
SLACK_BOT_CODER=xoxb-...
SLACK_BOT_OPENCODE=xoxb-...
# (no SLACK_BOT_OPENCLAW — openclaw has no agent.yaml; it runs under coder)

# ── Persona bot tokens (4) — one Slack app each ──────────────────────
SLACK_BOT_TEST=xoxb-...       # VTO TestRunner
SLACK_BOT_VIDEO=xoxb-...      # VTO VideoTester
SLACK_BOT_ACCURACY=xoxb-...   # VTO Accuracy
SLACK_BOT_SCOUT=xoxb-...      # VTO Scout

# ── Model providers ──────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...  # admin/critic/researcher/coder Hermes profiles
ANTHROPIC_API_KEY=            # optional; Claude/OpenClaw use the Claude CLI's own auth

# ── Product ──────────────────────────────────────────────────────────
VTO_STORE_PASSWORD=...        # dev-store password for the video harness
